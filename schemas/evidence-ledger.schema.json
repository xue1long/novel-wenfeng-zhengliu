{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenfeng.local/schemas/evidence-ledger.schema.json",
  "title": "wenfeng evidence ledger (private)",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "entries"],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{4,64}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "mechanism_id",
          "chunk_id",
          "char_offset",
          "excerpt",
          "decision"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{4,64}$"
          },
          "mechanism_id": {
            "type": "string",
            "pattern": "^M[0-9]{2,}$"
          },
          "chunk_id": {
            "type": "string",
            "minLength": 1
          },
          "char_offset": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 },
            "x-wenfengRange": "open"
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "x-wenfengCodepointMax": 200,
            "description": "Private short excerpt; spec §4.1 caps at 200 Unicode codepoints."
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "counter_examples": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "decision": {
            "enum": ["supports", "fails_to_support", "ambiguous"]
          }
        }
      }
    }
  }
}