{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenfeng.local/schemas/eval-suite.schema.json",
  "title": "wenfeng evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_version",
    "policy_version",
    "model",
    "prompt_version",
    "tool_version",
    "case_version",
    "entries"
  ],
  "properties": {
    "suite_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "case_version": {
      "type": "string",
      "minLength": 1
    },
    "generation_params": {
      "type": "object",
      "additionalProperties": true,
      "description": "Forward-compatible bag for temperature, top_p, etc."
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_requests", "max_input_tokens_total", "max_tokens_per_batch", "overlimit_policy"],
      "properties": {
        "max_requests": { "type": "integer", "minimum": 1 },
        "max_input_tokens_total": { "type": "integer", "minimum": 1 },
        "max_tokens_per_batch": { "type": "integer", "minimum": 1 },
        "overlimit_policy": { "enum": ["block", "degrade_to_limited", "retry"] }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "stage_id",
          "input_hash",
          "output_hash",
          "completion_status",
          "incomplete_reason"
        ],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "stage_id": {
            "enum": [
              "write_entry",
              "scene_design",
              "character_beats",
              "prose_draft",
              "style_check",
              "revision"
            ]
          },
          "input_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "output_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "completion_status": { "enum": ["complete", "incomplete"] },
          "incomplete_reason": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          }
        }
      }
    }
  }
}