{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenfeng.local/schemas/stage-context.schema.json",
  "title": "wenfeng stage context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "trace_id",
    "bundle_id",
    "stage_id",
    "retry_count",
    "stage_snapshot",
    "next_stage",
    "return_to"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{4,64}$"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{4,64}$"
    },
    "stage_id": {
      "enum": [
        "write_entry",
        "scene_design",
        "character_beats",
        "prose_draft",
        "style_check",
        "revision",
        "completed"
      ]
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "stage_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_fields"],
      "properties": {
        "input_refs": {
          "type": "array",
          "items": { "type": "string", "format": "uri-reference" }
        },
        "output_refs": {
          "type": "array",
          "items": { "type": "string", "format": "uri-reference" }
        },
        "changed_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "error_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_type"],
      "properties": {
        "error_type": { "type": "string", "minLength": 1 },
        "conflicting_stage": {
          "enum": [
            "write_entry",
            "scene_design",
            "character_beats",
            "prose_draft",
            "style_check",
            "revision"
          ]
        },
        "mechanism_id": { "type": "string", "pattern": "^M[0-9]{2,}$" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "next_stage": {
      "oneOf": [
        { "type": "null" },
        {
          "enum": [
            "write_entry",
            "scene_design",
            "character_beats",
            "prose_draft",
            "style_check",
            "revision",
            "completed"
          ]
        }
      ]
    },
    "return_to": {
      "oneOf": [
        { "type": "null" },
        {
          "enum": [
            "write_entry",
            "scene_design",
            "character_beats",
            "prose_draft",
            "style_check",
            "revision"
          ]
        }
      ]
    }
  }
}